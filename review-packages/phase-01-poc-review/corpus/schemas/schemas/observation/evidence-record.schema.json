{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://17th2nd.github.io/ASA-Astro/schemas/evidence-record.schema.json",
  "title": "Evidence Record",
  "x-governing-document": "ASTRO-ONTOLOGY-0001",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ontology_version", "record_status", "epistemic_classification", "id", "subject_id", "supported_claim", "evidence_role", "observation_source_id", "detector_output_id", "provenance_record_id", "evidence_kind", "image_region", "coordinate_context", "measurements", "quality_flags", "limitations", "independence_group", "uncertainty", "derivation"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "ontology_version": {"$ref": "common.schema.json#/$defs/ontology_version"},
    "record_status": {"$ref": "common.schema.json#/$defs/record_status"},
    "epistemic_classification": {"$ref": "common.schema.json#/$defs/epistemic_classification"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "subject_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "supported_claim": {"type": "string", "minLength": 1},
    "evidence_role": {"enum": ["supports", "contradicts", "contextualises"]},
    "observation_source_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "detector_output_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "provenance_record_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "evidence_kind": {"enum": ["pixel_segmentation", "local_intensity_deficit", "derived_image_geometry"]},
    "image_region": {"$ref": "common.schema.json#/$defs/bbox"},
    "coordinate_context": {"type": "object", "additionalProperties": false, "required": ["frame", "epoch", "band"], "properties": {"frame": {"$ref": "common.schema.json#/$defs/declared_value"}, "epoch": {"$ref": "common.schema.json#/$defs/declared_value"}, "band": {"$ref": "common.schema.json#/$defs/declared_value"}}},
    "measurements": {"type": "object", "minProperties": 1},
    "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "independence_group": {"type": "string", "minLength": 1},
    "uncertainty": {"$ref": "uncertainty.schema.json"},
    "derivation": {"type": "object", "required": ["method", "parameters"], "properties": {"method": {"type": "string"}, "parameters": {"type": "object"}}, "additionalProperties": false}
  }
}
