{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://17th2nd.github.io/ASA-Astro/schemas/candidate-relationship-assertion.schema.json",
  "title": "Candidate Relationship Assertion",
  "x-governing-document": "ASTRO-ONTOLOGY-0001 and ASTRO-RELATIONSHIP-TAXONOMY-0001",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ontology_version", "taxonomy_version", "record_status", "epistemic_classification", "id", "provenance_record_id", "claimant_method", "source_node_id", "target_node_id", "source_role", "target_role", "directionality", "relationship_type", "relationship_subtype", "relationship_classification", "coordinate_space", "reference_frame", "epoch", "observing_band", "observer", "status", "relationship_strength", "confidence", "evidence_ids", "supporting_evidence_ids", "contradicting_evidence_ids", "contextual_evidence_ids", "inference_basis", "physical_claim", "uncertainty"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "ontology_version": {"$ref": "common.schema.json#/$defs/ontology_version"},
    "taxonomy_version": {"const": "ASTRO-RELATIONSHIP-TAXONOMY-0001"},
    "record_status": {"$ref": "common.schema.json#/$defs/record_status"},
    "epistemic_classification": {"enum": ["computed", "inferred", "externally_supplied"]},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "provenance_record_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "claimant_method": {"const": "asa-astro-observation-to-graph-image-heuristic"},
    "source_node_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "target_node_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "source_role": {"type": "string", "minLength": 1},
    "target_role": {"type": "string", "minLength": 1},
    "directionality": {"enum": ["directed", "symmetric"]},
    "relationship_type": {"enum": ["spatial", "containment", "structural", "observational", "occlusion"]},
    "relationship_subtype": {"enum": ["proximity", "overlap", "containment", "orientation_alignment", "morphological_association", "occlusion", "shared_structural_region", "observational_dependency"]},
    "relationship_classification": {"enum": ["image_space_derived", "hypothesis", "dependency"]},
    "coordinate_space": {"const": "image_pixel"},
    "reference_frame": {"$ref": "common.schema.json#/$defs/declared_value"},
    "epoch": {"$ref": "common.schema.json#/$defs/declared_value"},
    "observing_band": {"$ref": "common.schema.json#/$defs/declared_value"},
    "observer": {"$ref": "common.schema.json#/$defs/declared_value"},
    "status": {"enum": ["derived", "hypothesis"]},
    "relationship_strength": {"$ref": "common.schema.json#/$defs/measurement"},
    "confidence": {"$ref": "confidence.schema.json"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "supporting_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "contradicting_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "contextual_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}},
    "inference_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "physical_claim": {"const": false},
    "uncertainty": {"$ref": "uncertainty.schema.json"}
  }
}
