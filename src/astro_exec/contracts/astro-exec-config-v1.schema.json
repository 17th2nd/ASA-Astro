{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asa-astro:astro-exec-config-v1",
  "title": "ASTRO-EXEC Phase 2 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "defaults", "execution", "frozen_artefacts", "roles"],
  "properties": {
    "schema_version": {"const": "astro-exec-config-v1"},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "applied"],
      "properties": {
        "policy": {"const": "no-implicit-defaults"},
        "applied": {"type": "array", "maxItems": 0}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {"mode": {"const": "dry-run"}}
    },
    "frozen_artefacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asalab", "custodian", "statistician", "truthlab"],
      "properties": {
        "asalab": {"$ref": "#/$defs/capabilities"},
        "custodian": {"$ref": "#/$defs/capabilities"},
        "statistician": {"$ref": "#/$defs/capabilities"},
        "truthlab": {"$ref": "#/$defs/capabilities"}
      }
    }
  },
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_roots", "write_roots"],
      "properties": {
        "read_roots": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "write_roots": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
