{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://17th2nd.github.io/ASA-Astro/schemas/catalogue-crossmatch.schema.json",
  "title": "Detection→Catalogue Crossmatch Result",
  "description": "Evidence-qualified catalogue crossmatch for one sky-localised detection. Emits matched / unresolved / contested. Matched requires catalogue evidence IDs; identity remains hypothesis until an explicit established-resolution step. Never collapses representation→entity. Never invents coordinates.",
  "x-governing-document": "ASTRO-ONTOLOGY-0001",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ontology_version", "record_status", "epistemic_classification", "id", "localisation_id", "detection_id", "resolution_state", "classification_status", "match_radius_arcsec", "candidates", "evidence_qualified", "catalogue_provenance", "inference_basis"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "ontology_version": {"$ref": "common.schema.json#/$defs/ontology_version"},
    "record_status": {"$ref": "common.schema.json#/$defs/record_status"},
    "epistemic_classification": {"const": "inferred"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "localisation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "detection_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "resolution_state": {"enum": ["matched", "unresolved", "contested", "unavailable"]},
    "classification_status": {"enum": ["hypothesis", "provisional", "unknown"], "description": "Catalogue association is never silently promoted to established identity"},
    "match_radius_arcsec": {"type": "number", "exclusiveMinimum": 0},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalogue_id", "catalogue_name", "separation_arcsec", "evidence_ids", "sky"],
        "properties": {
          "catalogue_id": {"type": "string", "minLength": 1},
          "catalogue_name": {"type": "string", "minLength": 1},
          "separation_arcsec": {"type": "number", "minimum": 0},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "sky": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ra_deg", "dec_deg"],
            "properties": {
              "ra_deg": {"type": "number"},
              "dec_deg": {"type": "number"},
              "frame": {"type": "string"},
              "epoch": {"type": "string"}
            }
          },
          "labels": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence_qualified": {"type": "boolean", "description": "True only when resolution_state=matched and the sole candidate carries one or more evidence_ids"},
    "catalogue_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_name", "release", "query_description"],
      "properties": {
        "catalogue_name": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1},
        "query_description": {"type": "string", "minLength": 1},
        "licence": {"type": "string"},
        "snapshot_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "unavailable_reason": {"type": "string"},
    "inference_basis": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
