{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://17th2nd.github.io/ASA-Astro/schemas/source-image-metadata.schema.json",
  "title": "Source Image Metadata",
  "x-governing-document": "ASTRO-ONTOLOGY-0001",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ontology_version", "record_status", "epistemic_classification", "id", "provenance_record_id", "observation_source_id", "width_pixels", "height_pixels", "format", "mode", "channels", "coordinate_frame", "epoch", "observing_band", "calibration_status", "physical_scale_status", "declared_metadata"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "ontology_version": {"$ref": "common.schema.json#/$defs/ontology_version"},
    "record_status": {"$ref": "common.schema.json#/$defs/record_status"},
    "epistemic_classification": {"$ref": "common.schema.json#/$defs/epistemic_classification"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"},
    "provenance_record_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "observation_source_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "width_pixels": {"type": "integer", "minimum": 1},
    "height_pixels": {"type": "integer", "minimum": 1},
    "format": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "channels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "coordinate_frame": {"$ref": "common.schema.json#/$defs/declared_value"},
    "epoch": {"$ref": "common.schema.json#/$defs/declared_value"},
    "observing_band": {"$ref": "common.schema.json#/$defs/declared_value"},
    "calibration_status": {"enum": ["unavailable", "provided_unverified", "verified"]},
    "physical_scale_status": {"enum": ["unavailable", "provided_unverified", "verified"]},
    "declared_metadata": {"type": "object"}
  }
}
