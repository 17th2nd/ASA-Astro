{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://17th2nd.github.io/ASA-Astro/schemas/standing-result.schema.json",
  "title": "Provisional Standing Result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "ontology_version", "taxonomy_version", "record_status", "epistemic_classification", "id", "subject_id", "algorithm_version", "policy", "asa_dependency_status", "input_graph_sha256", "input_provenance_sha256", "score", "raw_score", "component_contributions", "confidence_adjustment", "uncertainty_penalty", "centrality_termination", "provenance_refs", "warnings"],
  "properties": {
    "schema_version": {"const": "0.1.0"}, "ontology_version": {"$ref": "common.schema.json#/$defs/ontology_version"}, "taxonomy_version": {"const": "ASTRO-RELATIONSHIP-TAXONOMY-0001"}, "record_status": {"const": "active"}, "epistemic_classification": {"const": "computed"},
    "id": {"$ref": "common.schema.json#/$defs/identifier"}, "subject_id": {"$ref": "common.schema.json#/$defs/identifier"}, "algorithm_version": {"type": "string", "minLength": 1}, "policy": {"type": "object"}, "asa_dependency_status": {"const": "unavailable_not_consumed"}, "input_graph_sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "input_provenance_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "score": {"type": "number", "minimum": 0, "maximum": 1}, "raw_score": {"type": "number", "minimum": 0}, "component_contributions": {"type": "object", "minProperties": 8}, "confidence_adjustment": {"type": "number", "minimum": 0, "maximum": 1}, "uncertainty_penalty": {"type": "number", "minimum": 0, "maximum": 1}, "centrality_termination": {"type": "object", "required": ["iterations", "converged", "maximum_iterations"]},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/identifier"}}, "warnings": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
